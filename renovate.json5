{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>codeandsolder/ci-workflows:renovate-fleet"
  ],
  "timezone": "Europe/Warsaw",
  "dependencyDashboard": true,
  "schedule": [
    "before 6am on monday"
  ],
  "prConcurrentLimit": 10,
  "packageRules": [
    {
      "description": "Group routine Rust dependency updates",
      "matchManagers": [
        "cargo"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "groupName": "Rust dependencies"
    },
    {
      "description": "Group routine GitHub Actions updates",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Keep major dependency upgrades isolated for review",
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Keep Rust toolchain action updates separate from other Actions",
      "matchPackageNames": [
        "dtolnay/rust-toolchain"
      ],
      "groupName": "Rust toolchain"
    },
    {
      "description": "Advance the HTTP/2 and Netty publication atomically; exclude other patch families",
      "matchManagers": [
        "cargo"
      ],
      "matchDatasources": [
        "github-tags"
      ],
      "matchPackageNames": [
        "codeandsolder/cargo-patches"
      ],
      "matchDepNames": [
        "http2",
        "netty"
      ],
      "versioning": "semver",
      "groupName": "Wreq transport patch family",
      "groupSlug": "wreq-transport-patch-family",
      "versionCompatibility": "^(?<compatibility>wreq-transport-v)(?<version>\\d+\\.\\d+\\.\\d+)$"
    }
  ]
}
