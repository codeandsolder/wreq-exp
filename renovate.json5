{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>codeandsolder/ci-workflows:renovate-upstream-fork"],
  "forkProcessing": "enabled",
  "enabledManagers": ["github-actions", "cargo"],
  "packageRules": [
    {
      "description": "Maintain only the fork-owned BTLS Git pin; keep all three crates on one revision",
      "matchManagers": ["cargo"],
      "matchDatasources": ["git-refs"],
      "matchPackageNames": ["/^https:\\\\/\\\\/github\\\\.com\\\\/codeandsolder\\\\/btls-fast(?:\\\\.git)?$/"],
      "matchUpdateTypes": ["digest"],
      "enabled": true,
      "groupName": "BTLS git family",
      "groupSlug": "btls-git-family",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Maintain the fork-owned zlib-rs-fast Git pin",
      "matchManagers": ["cargo"],
      "matchDatasources": ["git-refs"],
      "matchPackageNames": ["/^https:\\\\/\\\\/github\\\\.com\\\\/codeandsolder\\\\/zlib-rs-fast(?:\\\\.git)?$/"],
      "matchUpdateTypes": ["digest"],
      "enabled": true,
      "automerge": true,
      "automergeType": "pr"
    }
  ]
}
