 on:
   push:
-    branches:
-      - main
-      - "0.16.x"
+    branches: [main]
+  pull_request:
+    branches: [main]
+    paths:
+      - ".github/workflows/release-plz.yml"
 
 jobs:
+  release-plz-readiness:
+    name: Release-plz dependency check
+    runs-on: ubuntu-latest
+    if: ${{ github.repository_owner == '0x676e67' }}
+    permissions:
+      contents: read
+    outputs:
+      ready: ${{ steps.patches.outputs.ready }}
+    steps:
+      - name: Checkout repository
+        uses: actions/checkout@v7
+        with:
+          persist-credentials: false
+      - name: Check for temporary dependency patches
+        id: patches
+        run: |
+          python3 - <<'PY'
+          import os
+          import tomllib
+          from pathlib import Path
+
+          manifest = tomllib.loads(Path("Cargo.toml").read_text())
+          patches = manifest.get("patch", {}).get("crates-io", {})
+          temporary = {"btls", "btls-sys", "tokio-btls", "http2", "netty"}
+          active = sorted(
+              name
+              for name, source in patches.items()
+              if name in temporary
+              and isinstance(source, dict)
+              and ("git" in source or "path" in source)
+          )
+          if active:
+              print("::notice::Release PR generation paused for temporary patches: " + ", ".join(active))
+          else:
+              print("Release PR generation enabled")
+          with open(os.environ["GITHUB_OUTPUT"], "a") as output:
+              print(f"ready={'false' if active else 'true'}", file=output)
+          PY
+
   release-plz-release:
     name: Release-plz release
     runs-on: ubuntu-latest
-    if: ${{ github.repository_owner == '0x676e67' }}
+    if: ${{ github.event_name == 'push' && github.repository_owner == '0x676e67' }}
     outputs:
       releases_created: ${{ steps.release-plz.outputs.releases_created }}
